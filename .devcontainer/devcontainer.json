{
  "name": "CloudVault Platform Control Plane",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableOnSwarm": false
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "go.toolsManagement.autoUpdate": true
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.ansible",
        "golang.go",
        "hashicorp.terraform",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "ubuntu",
  "postCreateCommand": "make --version && ansible --version && kubectl version --client"
}

